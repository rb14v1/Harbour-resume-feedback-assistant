# Copy to .env and fill in real values before running docker compose.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- Database (Postgres) ---
POSTGRES_DB=resume_feedback_assistant
POSTGRES_USER=resume_feedback_assistant
POSTGRES_PASSWORD=resume_feedback_assistant
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# DEV-ONLY: set USE_SQLITE=True to run manage.py commands against local
# SQLite with no Postgres/Docker available (e.g. `manage.py check`,
# `makemigrations`, `test`). Never set this in docker-compose/production.
USE_SQLITE=False

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI (resume feedback + cover letter draft) ---
# Leave OPENAI_API_KEY unset to run fully offline on deterministic stub
# output (no network, no cost) - see backend/apps/common/ai.py.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.4-mini

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api
